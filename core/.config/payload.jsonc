// Payload Schematic Format 2
{
    "Meta": {
        "File": "payload.jsonc",
        "Desc": "Configure Payload Schematic",
        "Version": "0.2.15",
        "Date": "7.3.25",
        "Int": "6.9.25",
        "Dev": "AngrySatan666"
    },
    "Schema": {
        "Incoming": {
            "desc": "Incoming from Client to the EndPoint Payload Schema",
            "type": "object",
            "properties": {
                "key": {
                    "type": "string",
                    "desc": "Authorization Key",
                    "pattern": "^\\d{2}-[A-Z][A-Za-z0-9]{10}$"
                },
                "action": {
                    "type": "string",
                    "desc": "Tells the Api Which Action to Perform",
                    "enum": [
                        "--btc",
                        "--ico_conv",
                        "--yfpuller"
                    ]
                },
                "arguments": {
                    "type": "array",
                    "desc": "Further Configures the Actions Performed",
                    "items": {
                        "type": "object",
                        "desc": "The Argument and its Value",
                        "minProperties": 1,
                        "maxProperties": 1,
                        "additionalProperties": false,
                        "patternProperties": {
                            "^--[a-zA-Z0-9_-]+$": {
                                "type": "string",
                                "desc": "Argument Value"
                            }
                        }
                    }
                },
                "attachments": {
                    "type": "object",
                    "desc": "Attachments for the Payload",
                    "properties": {
                        "files": {
                            "type": "array",
                            "desc": "Array of Attached Files",
                            "items": {
                                "type": "object",
                                "desc": "Attached Files Metadata",
                                "properties": {
                                    "base64": {
                                        "type": "object",
                                        "desc": "Base64 Encoded File Content",
                                        "properties": {
                                            "name": {
                                                "type": "string",
                                                "desc": "Original File Name"
                                            },
                                            "mime": {
                                                "type": "string",
                                                "desc": "MIME Type of the File",
                                                "enum": [
                                                    "image/png",
                                                    "image/jpeg",
                                                    "image/x-icon",
                                                    "image/svg+xml",
                                                    "image/gif",
                                                    "image/webp",
                                                    "text/plain"
                                                ]
                                            },
                                            "data": {
                                                "type": "string",
                                                "desc": "Base64 Encoded Binary Data of the File"
                                            }
                                        },
                                        "required": ["name", "mime", "data"]
                                    },
                                    "multipart": {
                                        "type": "array",
                                        "desc": "Array of Multipart File Metadata",
                                        "items": {
                                            "type": "object",
                                            "desc": "Multipart File Metadata",
                                            "properties": {
                                                "id": {
                                                    "type": "string",
                                                    "desc": "Unique Identifier for the Multipart File"
                                                },
                                                "name": {
                                                    "type": "string",
                                                    "desc": "Original File Name"
                                                },
                                                "mime": {
                                                    "type": "string",
                                                    "desc": "MIME Type of the File",
                                                    "enum": [
                                                        "image/png",
                                                        "image/jpeg",
                                                        "image/x-icon",
                                                        "image/svg+xml",
                                                        "image/gif",
                                                        "image/webp",
                                                        "text/plain"
                                                    ]
                                                }
                                            },
                                            "required": ["id", "name", "mime"]
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "required": ["files"]
                },
                "comment": {
                    "type": "string",
                    "desc": "Optional comment or chat message from GPT or user"
                }
            },
            "required": ["key", "action"]
        },
        "Receiving": {
            "desc": "Incoming Payload Enriched by Server Schema",
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "desc": "Unique Identifier for the Payload Event"
                },
                "ip": {
                    "type": "string",
                    "desc": "IP Address of the Payload Sender"
                },
                "timestamp": {
                    "type": "string",
                    "desc": "ISO8601 Timestamp of When the Payload was Received"
                }
            },
            "required": ["id", "ip", "timestamp"]
        },
        "Outgoing": {
            "desc": "Response Payload Schema from Server to Client",
            "type": "object",
            "properties": {
                "status": {
                    "type": "integer",
                    "desc": "HTTP Status Code",
                    "enum": [
                        200,
                        400,
                        404,
                        500,
                        666
                    ]
                },
                "id": {
                    "type": "string",
                    "desc": "Unique Identifier for the Payload Event"
                },
                "body": {
                    "type": "object",
                    "desc": "Response Body",
                    "properties": {
                        "result": {
                            "type": "string",
                            "desc": "Result of the Action Performed",
                            "enum": [
                                "success",
                                "error",
                                "warning"
                            ]
                        },
                        "message": {
                            "type": "string",
                            "desc": "PIPE STDOUT Message from the Action"
                        }
                    },
                    "required": ["result", "message"]
                },
                "attachments": {
                    "type": "object",
                    "desc": "Attachments for the Payload",
                    "properties": {
                        "files": {
                            "type": "array",
                            "desc": "Array of Attached Files",
                            "items": {
                                "type": "object",
                                "desc": "Attached Files Metadata",
                                "properties": {
                                    "base64": {
                                        "type": "object",
                                        "desc": "Base64 Encoded File Content",
                                        "properties": {
                                            "name": {
                                                "type": "string",
                                                "desc": "Original File Name"
                                            },
                                            "mime": {
                                                "type": "string",
                                                "desc": "MIME Type of the File",
                                                "enum": [
                                                    "image/png",
                                                    "image/jpeg",
                                                    "image/x-icon",
                                                    "image/svg+xml",
                                                    "image/gif",
                                                    "image/webp",
                                                    "text/plain"
                                                ]
                                            },
                                            "data": {
                                                "type": "string",
                                                "desc": "Base64 Encoded Binary Data of the File"
                                            }
                                        },
                                        "required": ["name", "mime", "data"]
                                    },
                                    "multipart": {
                                        "type": "array",
                                        "desc": "Array of Multipart File Metadata",
                                        "items": {
                                            "type": "object",
                                            "desc": "Multipart File Metadata",
                                            "properties": {
                                                "id": {
                                                    "type": "string",
                                                    "desc": "Unique Identifier for the Multipart File"
                                                },
                                                "name": {
                                                    "type": "string",
                                                    "desc": "Original File Name"
                                                },
                                                "mime": {
                                                    "type": "string",
                                                    "desc": "MIME Type of the File",
                                                    "enum": [
                                                        "image/png",
                                                        "image/jpeg",
                                                        "image/x-icon",
                                                        "image/svg+xml",
                                                        "image/gif",
                                                        "image/webp",
                                                        "text/plain"
                                                    ]
                                                }
                                            },
                                            "required": ["id", "name", "mime"]
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "required": ["files"]
                }
            },
            "required": ["status", "id", "body"]
        }
    }
}
