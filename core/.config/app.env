"" = Expansive Text: Variables
'' = String Text
{} = Numerical
[] = Section
<> = Unknown Variable
"($ )" = Command Line / Bash

# /1.0/ PostgreSQL Configs
[Flask Uri Connection]
uri = "app.config['SQLALCHEMY_DATABASE_URI']"="($ postgresql+psycopg2://username:tfukgobx@localhost:6666/intellicap)"

[Installation Record]
Installation_Directory = 'C:\Program Files\PostgreSQL\17'
Server_Installation_Directory = 'C:\Program Files\PostgreSQL\17'
Data_Directory = 'C:\Program Files\PostgreSQL\17\data'
Database_Port = {6666}
Database_Superuser = 'postgres'
Operating_System_Account = 'NT AUTHORITY\NetworkService'
Database_Service = 'postgresql-x64-17'
Command_Line_Tools_Installation_Directory = 'C:\Program Files\PostgreSQL\17'
pgAdmin4_Installation_Directory = 'C:\Program Files\PostgreSQL\17\pgAdmin 4'
Stack_Builder_Installation_Directory = 'C:\Program Files\PostgreSQL\17'
Installation_Log = 'C:\Users\angry\AppData\Local\Temp\install-postgresql.log'

[CMD.Connect]
connect = "($ psql -U postgres -h localhost -p 6666)"
pass = "($ tfukgobx)"

[CMD.Commands]
List_dbs = "($ /list)"
Change_User = "($ ALTER USER <username> RENAME TO <new_username>;)"
Change_Pass = "($ ALTER USER <username> WITH PASSWORD '<new_pass>';)"
New_User = "($ CREATE USER <username> WITH PASSWORD '<pass>';)"
Grant_Privileges = "($ ALTER USER <username> WITH SUPERUSER;)"
New_Db = "($ CREATE DATABASE <db_name> OWNER <username>;)"

[VsExtension: Postgresql]
server_name = "localhost"
Auth_Type = "password"
username = <username>
password = <pass>
db_name = <db_name>
server_port = {6666} # In Advanced Settings
connection_name = 'ANY String' # Extension Reference
Server_Group = 'ANY String' # Extension Reference

# /2.0/ Code Server Configs
[Code-Server Windows]
depends = ["wsl2", "ubuntu/debian"]
distro_depends = ["curl"]
curl = "($ curl -fsSL https://code-server.dev/install.sh | sh)"
path = "($ echo 'export PATH=$PATH:/usr/bin/lib/code-server/bin' >> ~/.bashrc && source ~/.bashrc)"
server_config = '~//config/code-server/config.yaml'
run = "($ code-server --port {port} --auth none)"

# /3.0/ Windows Config
NoAdmin_Prompt = 'HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System'
ConsentPromptBehaviorAdmin = 0 # Default is 5 @ Hexadecimal
Manual_Trigger = 'Tiny Button on Left, Set to 0, save'

[BTC Wallet]
pub_key =
pri_key =




